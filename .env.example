# ==============================================================================
# RoomRevive AI Environment Variables
# ==============================================================================

# Frontend (Client-side)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend (Server-side Authentication)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/roomrevive?retryWrites=true&w=majority

# AI Image Generation (Pollinations AI Flux API)
POLLINATIONS_API_KEY=""

# Multimodal Room Analysis & Design Planning
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Live Google Shopping Integration (Optional)
SERPAPI_API_KEY=""

# Generation Limits & Security
DAILY_GENERATION_LIMIT=15

# Hosting Configuration
APP_URL="MY_APP_URL"

